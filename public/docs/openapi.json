                    "isDuplicate": { "type": "boolean", "example": false },
                    "verdict": { "type": "string", "example": "Highly Unique — Proceed with Proposal" },
                    "matchedTheses": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
