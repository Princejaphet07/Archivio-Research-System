    "/api/ai/similarity-check": {
      "post": {
        "tags": ["AI & Research Intelligence"],
        "summary": "Research Duplication & Plagiarism Screen",
        "description": "Scans proposed thesis titles, objectives, and scopes against all active and archived papers in Southwestern University PHINMA to prevent topic redundancy.",
        "operationId": "aiSimilarityCheck",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "abstract"],
