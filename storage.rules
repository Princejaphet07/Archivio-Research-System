rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tugotan ang tanan nga mo-view/download sa public files (logos, published research)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Tugotan ang mga naka-login nga users nga maka-upload ug maka-basa sa files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
