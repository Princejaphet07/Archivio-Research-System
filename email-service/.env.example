# Email Service Configuration - PHINMA Institutional Email
# Copy this file to .env and fill in your actual credentials

# SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@phinmaed.com
EMAIL_PASSWORD=your-app-password

# Server Port
PORT=3001

# Frontend URL for CORS (set this to your deployed frontend domain)
# Example: https://archivio-research-system.vercel.app
# Leave empty to allow localhost only during development
FRONTEND_URL=https://your-archivio-domain.vercel.app

# Cloudinary Setup for Secure Deletions
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key
