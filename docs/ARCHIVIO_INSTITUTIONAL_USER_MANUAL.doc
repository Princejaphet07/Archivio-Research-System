    </tr>
    <tr>
      <td><strong>Upload Defense Deliverables</strong></td>
      <td>Upload 7 Milestones</td>
      <td>View Only</td>
      <td>View Only</td>
      <td>View Only</td>
      <td>Governance</td>
    </tr>
    <tr>
      <td><strong>Milestone Evaluation & Revisions</strong></td>
      <td>View Feedback</td>
      <td>Review & Return</td>
      <td>Review & Return</td>
      <td>Full Dual Review</td>
      <td>Audit View</td>
    </tr>
    <tr>
      <td><strong>Endorsement to Dean</strong></td>
      <td>No</td>
