rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : 'none';
    }
    function isSystemAdmin() {
      return isAuthenticated() && (getUserRole() == 'super-admin' || getUserRole() == 'admin');
    }
    function isDean() {
      return isAuthenticated() && (getUserRole() == 'dean' || getUserRole() == 'dean+adviser');
    }
    function isAdviser() {
      return isAuthenticated() && (getUserRole() == 'adviser' || getUserRole() == 'dean+adviser');
    }
    function isGroupMember(groupId) {
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return isAuthenticated() && (request.auth.uid == groupData.leaderUid || (groupData.coAuthors != null && request.auth.uid in groupData.coAuthors));
    }

    // 2. Protect Users & Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isSystemAdmin() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow create: if isSystemAdmin() || isDean() || (request.auth.uid == userId && (request.resource.data.role == 'adviser' || request.resource.data.role == 'student'));
      allow delete: if isSystemAdmin() || isDean();
    }
    
    match /students/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin() || isDean() || isAdviser() || request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid;
    }
    
    match /advisers/{docId} {
      allow read: if true; 
      allow write: if isSystemAdmin() || isDean() || request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;
    }
    
    match /deans/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin() || isDean() || request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid;
    }

    // 3. System Config & Logs
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }
    
    match /activity_logs/{docId} {
      allow read: if isSystemAdmin() || isDean();
      allow create: if true;
      allow update, delete: if isSystemAdmin();
    }
    
    match /systemLogs/{docId} {
      allow read: if isSystemAdmin() || isDean();
      allow create: if isAuthenticated();
      allow update, delete: if isSystemAdmin();
    }
    
    match /dean_settings/{userId} {
      allow read, write: if request.auth.uid == userId || isSystemAdmin();
    }
    
    match /requirements/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin() || isDean() || isAdviser();
    }
    
    match /departments/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }
    
    match /programs/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }
    
    match /super_admins/{docId} {
      allow read, write: if isSystemAdmin();
    }

    // 4. Research Data, Invitations & Submissions
    match /groups/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSystemAdmin() || isDean() || isAdviser() || resource.data.leaderUid == request.auth.uid;
    }
    
    match /submissions/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isSystemAdmin() || isDean() || request.resource.data.studentUid == request.auth.uid);
      
      // Allow the owner/admins to do full updates.
      // Allow anyone to update 'views' and 'likes'.
      allow update: if isSystemAdmin() || isDean() || isAdviser() || (isAuthenticated() && resource.data.studentUid == request.auth.uid)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']);
                    
      allow delete: if isSystemAdmin() || isDean() || isAdviser() || (isAuthenticated() && resource.data.studentUid == request.auth.uid);
    }
    
    match /studentInvitations/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /invitations/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Email trigger collection permissions (Firebase Email Extension)
    match /mail/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSystemAdmin();
    }

    match /emails/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSystemAdmin();
    }
    
    match /notifications/{docId} {
      allow read, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }
    
    match /userChats/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /chats/{groupId}/messages/{messageId} {
      allow read, write: if isAuthenticated() && (isSystemAdmin() || isDean() || isAdviser() || isGroupMember(groupId));
    }
    
    match /user_bookmarks/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /activity_logs_backup/{docId} {
      allow read: if isSystemAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin() || isDean() || isAdviser();
    }

    // 5. Fallback Default Deny
    match /{document=**} {
      allow read, write: if isSystemAdmin();
    }
  }
}
