rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : 'none';
    }
    function isSystemAdmin() {
      return isAuthenticated() && getUserRole() == 'super-admin';
    }
    function isDean() {
      return isAuthenticated() && getUserRole() == 'dean';
    }
    function isAdviser() {
      return isAuthenticated() && getUserRole() == 'adviser';
    }

    // 2. Protect Users & Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only system admin can update roles/users (prevent role escalation)
      allow write: if isSystemAdmin();
    }
    
    match /students/{docId} {
      // Students can read/write their own profile. Admins/Deans/Advisers can read all.
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin() || request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid;
    }
    
    match /advisers/{docId} {
      allow read: if true; // Public for signup
      allow write: if isSystemAdmin() || request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;
    }
    
    match /deans/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin() || request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid;
    }

    // 3. System Config & Logs
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }
    
    match /activity_logs/{docId} {
      // Anyone logged in can insert a log (for auditing), but no one can delete them
      allow read: if isSystemAdmin() || isDean();
      allow create: if isAuthenticated();
      allow update, delete: if isSystemAdmin();
    }

    // 4. Research Data (Groups & Submissions)
    match /groups/{docId} {
      allow read: if true; // Public archive needs group data
      // Anyone can create. To update/delete, must be admin, dean, adviser, or the leader of the group
      allow create: if isAuthenticated();
      allow update, delete: if isSystemAdmin() || isDean() || isAdviser() || resource.data.leaderUid == request.auth.uid;
    }
    
    match /submissions/{docId} {
      // Public can read published papers. Logged in users can read all.
      allow read: if (resource.data.reviewStatus == 'published' || resource.data.status == 'published') || isAuthenticated();
      // To create/update/delete, must be admin, dean, adviser, or the student owner
      allow create: if isAuthenticated();
      allow update, delete: if isSystemAdmin() || isDean() || isAdviser() || resource.data.studentUid == request.auth.uid;
    }
    
    match /studentInvitations/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /notifications/{docId} {
      allow read, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }
    
    match /userChats/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }
    
    match /user_bookmarks/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // 5. Fallback Default Deny
    match /{document=**} {
      allow read, write: if isSystemAdmin();
    }
  }
}
