rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Core Functions for Role-Based Access Control
    // ==========================================
    function isLoggedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {role: 'none'};
    }
    
    function isSystemAdmin() {
      return isLoggedIn() && getUserData().role == 'system_admin';
    }
    
    function isDean() {
      return isLoggedIn() && getUserData().role == 'dean';
    }
    
    function isAdviser() {
      return isLoggedIn() && getUserData().role == 'adviser';
    }
    
    function isStudent() {
      return isLoggedIn() && getUserData().role == 'student';
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      // Anyone logged in can read user profiles
      allow read: if isLoggedIn();
      
      // Users can update their own data, SysAdmin can update anyone's, Dean can update Advisers
      allow update: if isSystemAdmin() || 
                       (isLoggedIn() && request.auth.uid == userId) || 
                       (isDean() && resource.data.role == 'adviser');
                       
      // Anyone can create their initial profile during signup
      allow create: if isLoggedIn() && request.auth.uid == userId;
      
      // Only System Admins can delete users
      allow delete: if isSystemAdmin();
    }

    // ==========================================
    // 2. Submissions Collection (Research Papers)
    // ==========================================
    match /submissions/{submissionId} {
      // Public archive allows anyone to read published papers.
      // Other roles can read all submissions.
      allow read: if true; 
      
      // Only students can create a new submission
      allow create: if isStudent();
      
      // Strict Update Constraints
      allow update: if 
        // 1. Student can update their own paper ONLY if it's not approved or published yet
        (isStudent() && resource.data.studentUid == request.auth.uid && resource.data.reviewStatus in ['in_progress', 'revision', 'pending']) ||
        
        // 2. Adviser can approve papers
        isAdviser() ||
        
        // 3. Dean can publish papers
        isDean() ||
        
        // 4. System Admin can do anything
        isSystemAdmin();
        
      allow delete: if isSystemAdmin() || isAdviser();
    }

    // ==========================================
    // 3. Groups Collection
    // ==========================================
    match /groups/{groupId} {
      // Anyone can read group info
      allow read: if true;
      allow create: if isStudent() || isAdviser();
      allow update: if isStudent() || isAdviser() || isDean() || isSystemAdmin();
      allow delete: if isSystemAdmin() || isAdviser() || isDean();
    }

    // ==========================================
    // 4. Settings & Requirements (Admin/Dean Level)
    // ==========================================
    match /settings/{document=**} {
      allow read: if true;
      // Only System Admin can change maintenance mode and settings
      allow write: if isSystemAdmin();
    }
    
    match /requirements/{reqId} {
      allow read: if true;
      // Only Deans and SysAdmins can modify submission requirements
      allow write: if isDean() || isSystemAdmin();
    }

    // ==========================================
    // 5. Communications & Logs
    // ==========================================
    match /messages/{messageId} {
      allow read, create: if isLoggedIn();
      allow update, delete: if isSystemAdmin();
    }

    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update: if isSystemAdmin() || isDean() || isAdviser();
      allow delete: if isSystemAdmin() || isDean() || isAdviser();
    }

    match /notifications/{notificationId} {
      // Users can only see their own notifications
      allow read: if isLoggedIn() && resource.data.userId == request.auth.uid;
      // Anyone can send a notification
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && resource.data.userId == request.auth.uid;
    }
    
    match /activity_logs/{logId} {
      allow read: if isSystemAdmin() || isDean() || isAdviser();
      allow create: if isLoggedIn();
      allow update, delete: if isSystemAdmin();
    }

    // ==========================================
    // 6. User Bookmarks (Public Archive)
    // ==========================================
    match /user_bookmarks/{userId} {
      // Users can strictly only read and write their own bookmarks
      allow read, write: if isLoggedIn() && request.auth.uid == userId;
    }
  }
}
